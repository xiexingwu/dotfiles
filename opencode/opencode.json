{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "enabled": true,
      "oauth": {
        "clientId": "{env:SLACK_CLIENT_ID}",
        "clientSecret": "{env:SLACK_CLIENT_SECRET}",
        "scope": "canvases:read canvases:write channels:history channels:read channels:write chat:write emoji:read files:read groups:history groups:read groups:write im:history im:read im:write mpim:history mpim:read mpim:write reactions:read reactions:write search:read.files search:read.im search:read.mpim search:read.private search:read.public search:read.users users:read users:read.email"
      }
    }
  },
  "skills": {
    "paths": [
      "/Users/xiexingwu/.claude/plugins/synced/bf9ac33a-999b-4d9e-ab97-6b5fdebd78ac_f6db8d5f-5a90-43f9-8487-844ea159a695/team-data-analytics/skills"
    ]
  },
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
