# This is Git's per-user configuration file.
[user]
	name = Michael Xie
	email = michael@fullstackdata.dev

# Work repos (rome2rio org, or cloned via the github-r2r ssh alias) use the work identity.
[includeIf "hasconfig:remote.*.url:github-r2r:*/**"]
	path = ~/.gitconfig-r2r
[includeIf "hasconfig:remote.*.url:git@github.com:rome2rio/**"]
	path = ~/.gitconfig-r2r
[includeIf "hasconfig:remote.*.url:https://github.com/rome2rio/**"]
	path = ~/.gitconfig-r2r
[core]
	excludesfile = /Users/xiexingwu/.ignore
  pager = delta
	
[alias]
  ls = status --column -sb
  ll = log --oneline --graph

  ca = commit --amend

  f = fetch -p
  pr = pull --rebase
  co = checkout

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true  # use n and N to move between diff sections
  dark = true      # or light = true, or omit for auto-detection
  side-by-side = true

[merge]
  conflictstyle = zdiff3
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
