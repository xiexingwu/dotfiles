<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.proton.pass.ssh-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/xiexingwu/.local/bin/pass-cli</string>
        <string>ssh-agent</string>
        <string>start</string>
        <string>--socket-path</string>
        <string>/Users/xiexingwu/.ssh/proton-pass-agent.sock</string>
        <string>--vault-name</string>
        <string>Personal</string>
        <string>--refresh-interval</string>
        <string>3600</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/xiexingwu/.ssh/proton-pass-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xiexingwu/.ssh/proton-pass-agent.log</string>
</dict>
</plist>
